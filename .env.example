# OpenAI API Key (Whisper STT 및 자막 싱크 정렬용)
OPENAI_API_KEY=your_openai_api_key_here

# (선택) Gemini API Key (Gemini TTS 및 Google AI 연동용 - 없으면 Edge-TTS 자동 사용)
# GEMINI_API_KEY=your_gemini_api_key_here

# TTS 엔진 설정: edge (기본값, 무료/고속), gemini (Gemini API), qwen (로컬 Gradio 서버)
TTS_ENGINE=edge

# TTS 보이스 설정:
#   - Edge-TTS: ko-KR-SunHiNeural (여성 기본), ko-KR-InJoonNeural (남성), ko-KR-HyunsuMultilingualNeural
#   - Gemini-TTS: Kore (여성), Puck (남성), Charon, Fenrir, Aoede
TTS_VOICE=ko-KR-SunHiNeural

# 쿠팡 파트너스 Open API (coupang-crawler 스킬의 search / deeplink 모드용, 선택)
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=

# (선택) 무료 AI 이미지 생성 엔진 키 (발급 시 딜레이 없이 2~5초 고속 생성)
# 1) Pollinations 무료 키: enter.pollinations.ai 에서 구글 로그인 후 발급 (무제한 무료)
# POLLINATIONS_API_KEY=
# 2) Hugging Face 무료 토큰: huggingface.co/settings/tokens 에서 Read 토큰 발급
# HF_TOKEN=
# 3) SiliconFlow 무료 토큰: siliconflow.cn 가입 시 2천만 토큰 무료 지급
# SILICONFLOW_API_KEY=
