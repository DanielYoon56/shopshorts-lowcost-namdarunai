# OpenAI API Key (Whisper STT 및 자막 싱크 정렬용)
OPENAI_API_KEY=your_openai_api_key_here

# (선택) Gemini API Key (Gemini TTS 및 Google AI 연동용 - 없으면 Edge-TTS 자동 사용)
# GEMINI_API_KEY=your_gemini_api_key_here

# TTS 엔진 설정: edge (기본값, 무료/고속), gemini (Gemini API), qwen (로컬 Gradio 서버)
TTS_ENGINE=edge

# TTS 보이스 설정:
#   - Edge-TTS: ko-KR-SunHiNeural (여성 기본), ko-KR-InJoonNeural (남성), ko-KR-HyunsuMultilingualNeural
#   - Gemini-TTS: Kore (여성), Puck (남성), Charon, Fenrir, Aoede
TTS_VOICE=ko-KR-SunHiNeural

# 쿠팡 파트너스 Open API (coupang-crawler 스킬의 search / deeplink 모드용, 선택)
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=

# (선택) 무료 AI 이미지 생성 엔진 키 (발급 시 딜레이 없이 2~5초 고속 생성)
# 2) Hugging Face 무료 토큰: huggingface.co/settings/tokens 에서 Read 토큰 발급
# HF_TOKEN=
# 3) SiliconFlow 무료 토큰: siliconflow.cn 가입 시 2천만 토큰 무료 지급
# SILICONFLOW_API_KEY=

# =====================================================================
# 🚀 소셜 미디어 자동 업로드 설정 (유튜브 쇼츠 / 인스타그램 릴스)
# =====================================================================
# 1) YouTube Data API v3 (OAuth 2.0 클라이언트 ID & 시크릿)
#   - Google Cloud Console -> API 및 서비스 -> 사용자 인증 정보 -> OAuth 2.0 클라이언트 ID (데스크톱 앱)
#   - 단순 API Key(AIzaSy...)는 읽기 전용이므로 영상 업로드가 불가하며, 반드시 OAuth 클라이언트가 필요합니다.
# YOUTUBE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
# YOUTUBE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxx
# (또는 다운로드한 JSON 파일을 credentials/youtube_client_secret.json 에 넣어도 작동합니다)

# 2) Instagram Reels 설정 (instagrapi 자동 로그인용)
# INSTAGRAM_USERNAME=your_instagram_id
# INSTAGRAM_PASSWORD=your_instagram_password
